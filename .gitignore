# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Module code folders hold sources only. Compiling a single-file program on
# macOS/Linux produces an EXTENSIONLESS binary, which no *.ext rule can catch —
# so ignore everything in these folders and allow the source types back in.
modules/*/code/*
!modules/*/code/*.cpp
!modules/*/code/*.h
!modules/*/code/*.md

# debug information files
*.dwo
.DS_Store

# Python cache from the gate scripts
__pycache__/
*.pyc

# Agent worktrees. Workflow runs with isolation:'worktree' create full repo
# copies here (one per student in a cohort round). They are scaffolding for a
# run in progress, not deliverables — committing them would check a whole
# second copy of the repo into the repo. What a run produces is harvested
# into _tracking/cohort/<round>/ and _lore/ deliberately.
.claude/worktrees/
